FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_AGENT_NAME=<agent-name>
PORT=3001
# Optional: route Foundry calls through Azure API Management.
# Set FOUNDRY_PROJECT_ENDPOINT to the APIM API URL (for example https://<apim-name>.azure-api.net/foundry) and add the key.
# APIM_SUBSCRIPTION_KEY=<apim-subscription-key>
# Number of reverse proxies in front of this app (used to read the visitor IP). Default 1 for Azure App Service.
# TRUST_PROXY_HOPS=1
